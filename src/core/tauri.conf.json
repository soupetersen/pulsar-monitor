{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulsar",
  "version": "0.4.1",
  "identifier": "com.petersen.pulsar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Pulsar",
        "width": 372,
        "height": 132,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGRkVEQkU3MEZGOEZDMEMKUldRTS9QZ1A1OXYrbnk1Q0JVUmdJT0x3T2xWQVdLTnZubnAzYktIOGRZaHJmREducVZSQlpHWWYK",
      "endpoints": ["https://github.com/soupetersen/pulsar-monitor/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
