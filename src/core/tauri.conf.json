{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulsar",
  "version": "0.2.0",
  "identifier": "com.petersen.pulsar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pulsar",
        "width": 372,
        "height": 132,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "center": true,
        "visible": false,
        "windowEffects": {
          "effects": ["mica"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
